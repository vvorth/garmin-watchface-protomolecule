      <listEntry value="11184810">@Strings.ColorGray</listEntry>
      <listEntry value="65535">@Strings.ColorCyan</listEntry>
      <listEntry value="65280">@Strings.ColorGreen</listEntry>
      <listEntry value="16776960">@Strings.ColorYellow</listEntry>
      <listEntry value="16755200">@Strings.ColorOrange</listEntry>
      <listEntry value="16711680">@Strings.ColorRed</listEntry>
      <listEntry value="43775">@Strings.ColorBlue</listEntry>
    </settingConfig>
  </setting>
  <setting propertyKey="@Properties.minuteColor" title="@Strings.MinuteColor" prompt="@Strings.MinuteColorPrompt">
    <settingConfig type="list">
      <listEntry value="16777215">@Strings.ColorWhite</listEntry>
      <listEntry value="11184810">@Strings.ColorGray</listEntry>
      <listEntry value="65535">@Strings.ColorCyan</listEntry>
      <listEntry value="65280">@Strings.ColorGreen</listEntry>
      <listEntry value="16776960">@Strings.ColorYellow</listEntry>
      <listEntry value="16755200">@Strings.ColorOrange</listEntry>
      <listEntry value="16711680">@Strings.ColorRed</listEntry>
      <listEntry value="43775">@Strings.ColorBlue</listEntry>
    </settingConfig>
  </setting>
</settings>
